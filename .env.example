# Required secrets and infrastructure
API_KEY=replace-with-a-local-api-key
OPENAI_API_KEY=replace-with-an-openai-api-key
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=doc_intelligence
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-a-local-database-password@localhost:5432/doc_intelligence

# API and browser client policy
LEXIS_API_KEY_HEADER=X-API-Key
LEXIS_CORS_ORIGINS=http://localhost:5173
LEXIS_UPLOAD_RATE_LIMIT=5/minute
LEXIS_QUERY_RATE_LIMIT=20/minute
LEXIS_MAX_UPLOAD_BYTES=26214400
LEXIS_MAX_FILENAME_CHARACTERS=255
LEXIS_ACCEPTED_PDF_CONTENT_TYPES=application/pdf,application/x-pdf

# Hosted models
LEXIS_EMBEDDING_MODEL=text-embedding-3-small
LEXIS_EXPANSION_MODEL=gpt-4o-mini-2024-07-18
LEXIS_RERANKER_MODEL=gpt-4o-mini-2024-07-18
LEXIS_ANSWER_MODEL=gpt-4o-mini-2024-07-18

# Chunking
LEXIS_CHUNK_MAX_TOKENS=200
LEXIS_CHUNK_OVERLAP_TOKENS=30
LEXIS_CHUNK_MIN_TOKENS=40
LEXIS_CHUNK_ENCODING=cl100k_base

# Retrieval and evidence selection
LEXIS_DENSE_CANDIDATE_K=20
LEXIS_LEXICAL_CANDIDATE_K=20
LEXIS_RRF_K=10
LEXIS_RERANK_K=10
LEXIS_FINAL_EVIDENCE_K=5
LEXIS_RELEVANCE_CUTOFF=2
LEXIS_RERANKER_BATCH_SIZE=5

# Frontend (set in doc-intelligence-frontend/.env.local when needed)
VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY_HEADER=X-API-Key
